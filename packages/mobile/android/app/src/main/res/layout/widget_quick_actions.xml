<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center"
    android:padding="8dp" android:background="#252936">
    <Button android:id="@+id/widget_text" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:text="Text" android:textAllCaps="false" />
    <Button android:id="@+id/widget_voice" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:text="Voice" android:textAllCaps="false" />
    <Button android:id="@+id/widget_image" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:text="Image" android:textAllCaps="false" />
</LinearLayout>
